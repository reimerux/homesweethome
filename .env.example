# Home Sweet Home - Environment Variables Example
# Copy this to .env.local for development or .env.production for production

# ==========================================
# NEXTAUTH CONFIGURATION
# ==========================================

# Unique secret for JWT tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-32-character-random-secret-here

# Application URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# PostgreSQL connection details
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homesweethome

# Alternative connection string (if using connection pooling)
# POSTGRES_PRISMA_URL=postgresql://user:pass@host:port/db?schema=public
# POSTGRES_URL_NON_POOLING=postgresql://user:pass@host:port/db?schema=public

# ==========================================
# BACKUP SYSTEM CONFIGURATION
# ==========================================

# Directory to store backups (relative to project root)
BACKUP_DIR=./backups

# How long to keep backups (days)
BACKUP_RETENTION_DAYS=30

# ==========================================
# OPTIONAL: EXTERNAL SERVICES
# ==========================================

# Error tracking (Sentry)
# SENTRY_DSN=https://your-sentry-dsn-here

# Analytics
# ANALYTICS_KEY=your-analytics-key

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# PRODUCTION NOTES
# ==========================================

# For production deployment:
# 1. Use strong, unique passwords
# 2. Store secrets securely (not in git)
# 3. Use HTTPS URLs for NEXTAUTH_URL
# 4. Consider using managed database services (Neon, Supabase, AWS RDS)
# 5. Enable SSL/TLS for database connections
# 6. Set up automated backups and monitoring